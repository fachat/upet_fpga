10 REM UPET/VICCY-II 16 SPRITE DEMO
20 REM ENABLE MEMORY-MAPPED REGISTERS VIA R32 BIT 6
30 VC=59520:SY=59392:VW=59397:SP=59395
40 R2=32:RA=42:RF=46:RG=47:RZ=63:RB=64
42 REM FULL SPEED
44 POKE SP,3
46 PRINT "SETTING UP.";
48 REM MEM MAP VICCY
50 POKE VC,R2:V=PEEK(VC+1):POKE VC+1,V OR 64
60 POKE VC+R2,PEEK(VC+R2) OR 16
70 REM MAP VIDEO RAM INTO $8XXX, FULL 8K WINDOW
80 POKE SY,104:POKE VW,2
90 REM SPRITE POINTER PAGE HIGH BYTE ($97XX)
100 POKE VC+RA,151
105 REM SPRITE MULTICOLOURS
110 POKE VC+RF,2:POKE VC+RG,12
120 REM PREPARE BIT MASK TABLE
130 DIM M(7):FOR I=0 TO 7:M(I)=2^(7-I):NEXT
140 REM BUILD 16 DIFFERENT SPRITE SHAPES AT VRAM $9000-$93FF
150 FOR S=0 TO 15
160 B=32768+4096+S*64:K=S-4*INT(S/4)
170 FOR Y=0 TO 20
180 B0=0:B1=0:B2=0
190 FOR X=0 TO 23
200 P=0
210 IF K=0 THEN IF X=(Y+S)-24*INT((Y+S)/24) OR X=23-((Y+S)-24*INT((Y+S)/24)) THEN P=1
220 IF K=1 THEN IF Y=0 OR Y=20 OR X=0 OR X=23 OR X=(S-12*INT(S/12))+6 THEN P=1
230 IF K=2 THEN IF ((INT(X/2)+Y+S)-2*INT((INT(X/2)+Y+S)/2))=0 THEN P=1
240 IF K=3 THEN DX=X-12:DY=Y-10:RR=DX*DX+DY*DY:IF RR>30+S*2 AND RR<70+S*2 THEN P=1
250 IF P=1 THEN GOSUB 2000
260 NEXT X
270 POKE B+Y*3,B0:POKE B+Y*3+1,B1:POKE B+Y*3+2,B2
280 NEXT Y
290 POKE B+63,0
295 PRINT ".";
300 NEXT S
310 REM POINTER TABLE: 8-15 AT $97F0-$97F7, 0-7 AT $97F8-$97FF
320 FOR I=0 TO 7:POKE 34800+I,128+8+I:NEXT
330 FOR I=0 TO 7:POKE 34808+I,128+I:NEXT
340 REM SPRITE COLOURS (WINDOW 6)
350 POKE VC+RZ,6:FOR I=0 TO 15:POKE VC+RB+I,I:NEXT
360 DIM X(15),Y(15),DX(15),DY(15),T(15),MD(15)
370 FOR I=0 TO 15
380 X(I)=20+I*18:Y(I)=30+I*10
390 DX(I)=1+(I AND 3):DY(I)=1+((INT(I/2)) AND 3)
400 T(I)=I*8:MD(I)=INT(I/4)
410 NEXT I
415 PRINT
420 PRINT "16 SPRITE DEMO RUNNING - PRESS ANY KEY TO STOP"
430 A$=""
440 FOR S=0 TO 15
450 IF MD(S)=0 THEN GOSUB 3000
460 IF MD(S)=1 THEN GOSUB 3100
470 IF MD(S)=2 THEN GOSUB 3200
480 IF MD(S)=3 THEN GOSUB 3300
490 GOSUB 3400
500 NEXT S
510 GET A$:IF A$="" THEN 430
520 POKE VC+RZ,4:FOR S=0 TO 7:POKE VC+RB+S*4+3,0:NEXT
530 POKE VC+RZ,5:FOR S=0 TO 7:POKE VC+RB+S*4+3,0:NEXT
540 END
2000 IF X<8 THEN B0=B0 OR M(X):RETURN
2010 IF X<16 THEN B1=B1 OR M(X-8):RETURN
2020 B2=B2 OR M(X-16):RETURN
3000 X(S)=X(S)+DX(S):Y(S)=Y(S)+DY(S)
3010 IF X(S)>319 THEN X(S)=0
3020 IF Y(S)>239 THEN Y(S)=0
3030 RETURN
3100 X(S)=X(S)+DX(S):Y(S)=Y(S)+DY(S)
3110 IF X(S)<0 THEN X(S)=0:DX(S)=-DX(S)
3120 IF X(S)>319 THEN X(S)=319:DX(S)=-DX(S)
3130 IF Y(S)<0 THEN Y(S)=0:DY(S)=-DY(S)
3140 IF Y(S)>239 THEN Y(S)=239:DY(S)=-DY(S)
3150 RETURN
3200 T(S)=T(S)+2
3210 X(S)=20+((T(S)+S*7)-300*INT((T(S)+S*7)/300))
3220 Y(S)=120+INT(SIN((T(S)+S*9)/20)*70)
3230 RETURN
3300 T(S)=T(S)+3:A=(T(S)+S*25)/30
3310 X(S)=160+INT(COS(A)*(50+S*3))
3320 Y(S)=120+INT(SIN(A)*(30+S*2))
3330 RETURN
3400 IF S<8 THEN POKE VC+RZ,4:O=S*4:GOTO 3420
3410 POKE VC+RZ,5:IF PEEK(VC+RZ) <> 5 THEN 3500
3415 O=(S-8)*4
3420 XI=INT(X(S)):YI=INT(Y(S))
3430 POKE VC+RB+O,XI AND 255
3440 POKE VC+RB+O+1,YI AND 255
3450 E=0:IF XI>255 THEN E=E OR 1
3460 IF YI>255 THEN E=E OR 16
3470 POKE VC+RB+O+2,E
3480 C=33:IF (S AND 1)=1 THEN C=C OR 8
3490 POKE VC+RB+O+3,C
3500 RETURN
